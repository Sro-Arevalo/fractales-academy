{
  "name": "fractales-academy-azure",
  "version": "4.5.0",
  "private": true,
  "description": "Fractales Academy: gestión académica y administración segura sobre Azure SQL",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed:admin": "node scripts/create-admin.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-v45.js",
    "sql:build:v45": "node scripts/build-v45-sql.js",
    "test:sql:v45": "node scripts/test-v45-local.js",
    "preview:v45": "node scripts/preview-v45-local.js",
    "test:browser:v45": "node scripts/test-v45-browser.js && node scripts/test-v45-social.js",
    "package:v45": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-v45.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/identity": "4.13.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "nodemailer": "^10.2.1"
  },
  "overrides": {
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "msnodesqlv8": "^6.2.1",
    "playwright": "^1.64.1"
  }
}
