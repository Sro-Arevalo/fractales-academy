# Solo para desarrollo LOCAL. Nunca subir este archivo con claves reales.
NODE_ENV=development
PORT=3000
DB_AUTH_MODE=sql
DB_SERVER=tu-servidor.database.windows.net
DB_DATABASE=FractalesAcademyDB
DB_PORT=1433
DB_USER=USUARIO_SQL_CON_PERMISOS_LIMITADOS
DB_PASSWORD=REEMPLAZAR_SOLO_EN_TU_PC
# Generar aleatoriamente con Node (ver GUIA_AZURE_PASO_A_PASO.md)
JWT_SECRET=REEMPLAZAR_POR_CADENA_ALEATORIA_DE_64_CARACTERES
# Alternativa Azure: DB_AUTH_MODE=entra, habilitar identidad administrada y permisos SQL

# Recuperación V4.1. Desactivada hasta configurar un servicio SMTP propio.
# V4.3 acepta EMAIL_PROVIDER=local SOLO con NODE_ENV=development/test.
# preview:v43 ofrece /__local/mail en loopback para revisar la bandeja simulada.
# Nunca usar el proveedor local ni el script preview en Azure.
# Solo ejemplos ficticios; no cambies las variables DB ni JWT existentes al migrar.
EMAIL_PROVIDER=disabled
# auto permite únicamente una base V4 sin extensiones. Tras aprobar V4.1 usar required en producción.
ACCOUNT_SECURITY_V41=auto
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASSWORD=REEMPLAZAR_SOLO_AL_CONFIGURAR_EL_SERVICIO
EMAIL_FROM=no-responder@example.com
# SMS: únicamente interfaz preparada; no hay proveedor de producción habilitado.
SMS_PROVIDER=disabled
