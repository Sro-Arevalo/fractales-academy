# Solo para desarrollo LOCAL. Nunca subir este archivo con claves reales.
NODE_ENV=development
PORT=3000
DB_AUTH_MODE=sql
DB_SERVER=tu-servidor.database.windows.net
DB_DATABASE=FractalesAcademyDB
DB_PORT=1433
DB_USER=USUARIO_SQL_CON_PERMISOS_LIMITADOS
DB_PASSWORD=REEMPLAZAR_SOLO_EN_TU_PC
# Generar aleatoriamente con Node (ver GUIA_AZURE_PASO_A_PASO.md)
JWT_SECRET=REEMPLAZAR_POR_CADENA_ALEATORIA_DE_64_CARACTERES
# Alternativa Azure: DB_AUTH_MODE=entra, habilitar identidad administrada y permisos SQL
